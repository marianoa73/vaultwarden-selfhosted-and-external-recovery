# Copy to /etc/vw-recovery.env, mode 600. Every value is a placeholder: use your own paths and names.
VW_DATA_DIR=/path/to/vaultwarden/data          # where the server keeps db.sqlite3, attachments, rsa_key.pem
VW_BACKUP_OUT=/path/to/backups                 # local encrypted copies (primary server)
VW_PASSPHRASE_FILE=/path/to/backup-passphrase  # mode 600, readable only by the backup user
VW_KEEP=14                                     # copies kept
VW_REMOTE=backup-receiver                      # ssh alias of the remote receiver (primary server only)

# On the remote / standby host:
# VW_REMOTE_DIR=/path/to/received-backups      # used by vw-receive.sh
# VW_BACKUP_IN=/path/to/received-backups       # used by vw-restore.sh
# VW_COMPOSE_DIR=/path/to/standby/compose
